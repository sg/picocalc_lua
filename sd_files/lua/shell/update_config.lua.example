--[[

  Update configuration for PicoCalc Lua

  Copy this file to update_config.lua. Every key is optional:
  anything left out takes the built-in default shown below, so
  a file holding just "return {}" is enough when the defaults
  already fit.

  Supported platforms: "github", "forgejo", "gitea". For a Forgejo
  or Gitea instance use host = "https://your-instance" and
  download_base = "https://your-instance/<owner>/<repo>/releases/download".

  In the asset patterns {tag} is replaced with the release tag
  and {board} with the short board name build.sh uses (pico,
  picow, pico2, pico2w, pim2w), derived from sys.board.

]]

return {
  platform = "github",
  host = "https://api.github.com",
  owner = "sg",
  repo = "picocalc_lua",
  download_base = "https://github.com/sg/picocalc_lua/releases/download",
  sd_asset = "sd_files-{tag}.tar.gz",
  uf2_asset = "picolua-{board}-{tag}.uf2",
}
